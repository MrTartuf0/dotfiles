yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout bsp
yabai -m config window_placement second_child



# padding
yabai -m config top_padding 3
yabai -m config bottom_padding 4
yabai -m config left_padding 4
yabai -m config right_padding 4
yabai -m config window_gap 5

# mouse settings
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap


# --- REGOLE PER FUSION 360 ---

yabai -m rule --add app="^Fusion$" focus_follows_mouse=off
yabai -m rule --add app="^Fusion$" mouse_follows_focus=off
yabai -m rule --add app="^Autodesk Fusion$" focus_follows_mouse=off
yabai -m rule --add app="^Autodesk Fusion$" mouse_follows_focus=off
yabai -m rule --add app="^Autodesk Fusion$" manage=off
yabai -m rule --add app="^Autodesk Fusion 360$" manage=off
yabai -m rule --add app="^Fusion$" manage=off
yabai -m rule --add app="^Fusion$" subrole="^AXDialog$" manage=off
yabai -m rule --add app="^Fusion$" subrole="^AXDialog$" mouse_follows_focus=off
yabai -m rule --add app="^Fusion$" subrole="^AXDialog$" focus_follows_mouse=off
yabai -m rule --add app="^Autodesk Fusion$" manage=off mouse_follows_focus=off focus_follows_mouse=off
yabai -m rule --add app="^Fusion$" manage=off mouse_follows_focus=off focus_follows_mouse=off
yabai -m rule --add app="^Autodesk Fusion$" role="^AXUnknown$" manage=off focus_follows_mouse=off
yabai -m rule --add app="^Autodesk Fusion$" subrole="^AXFloatingWindow$" manage=off focus_follows_mouse=off
yabai -m rule --add app="^Autodesk Fusion$" subrole="^AXUnknown$" manage=off focus_follows_mouse=off
yabai -m rule --add app="^Autodesk Fusion$" role="^AXPopover$" manage=off focus_follows_mouse=off


yabai -m signal --add event=space_changed action="open -g 'swiftbar://refreshplugin?name=yabai_spaces.1d.sh'"